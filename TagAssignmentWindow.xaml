<Window x:Class="CustomImageViewer.TagAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="태그 관리" Width="590" Height="520"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#15181E" Foreground="#F2F4F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#2A2E36"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C2027"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="InstructionText" Grid.Row="1" Margin="0,6,0,14" Foreground="#AEB6C2"
                   Text="새 태그를 만들거나 기존 태그를 선택한 뒤 적용하세요. 선택한 모든 작업물에 태그가 추가됩니다."
                   TextWrapping="Wrap"/>

        <DockPanel x:Name="NewTagPanel" Grid.Row="2" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="추가" Click="AddTag_Click" Margin="7,0,0,0"/>
            <TextBox x:Name="NewTagBox" VerticalContentAlignment="Center"
                     ToolTip="여러 태그는 쉼표로 구분할 수 있습니다."
                     KeyDown="NewTagBox_KeyDown"/>
        </DockPanel>

        <Border Grid.Row="3" Background="#101319" BorderBrush="#333A46" BorderThickness="1"
                CornerRadius="4" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="AvailableTagsPanel"/>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="SelectedTagCountText" VerticalAlignment="Center" Foreground="#70B7FF"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="취소" Click="Cancel_Click"/>
                <Button x:Name="ApplyButton" Content="선택한 태그 적용" Click="Apply_Click"
                        Background="#245A8D" BorderBrush="#4B9AE8" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
