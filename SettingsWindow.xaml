<Window x:Class="CustomImageViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="680" Height="610" MinWidth="680" MinHeight="610"
        WindowStartupLocation="CenterOwner" Background="#15181E" Foreground="#F2F4F7">
    <Window.Resources>
        <SolidColorBrush x:Key="DarkSurfaceBrush" Color="#181B21"/>
        <SolidColorBrush x:Key="DarkControlBrush" Color="#2A2E36"/>
        <SolidColorBrush x:Key="DarkBorderBrush" Color="#434A56"/>
        <SolidColorBrush x:Key="LightTextBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB2BF"/>
        <SolidColorBrush x:Key="LightInputBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DarkInputTextBrush" Color="#111318"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{StaticResource LightInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DarkInputTextBrush}"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource LightInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DarkInputTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2E6EA8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#DCEBFA"/>
                    <Setter Property="Foreground" Value="#111318"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource LightInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DarkInputTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource DarkInputTextBrush}"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
            <Setter Property="SelectionBrush" Value="#6AA9E4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{StaticResource DarkControlBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#343942"/>
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                    <Setter Property="BorderBrush" Value="#454B55"/>
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource DarkSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#E7EAF0"/>
            <Setter Property="Background" Value="#22262E"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkSurfaceBrush}"/>
                    <Setter Property="Foreground" Value="#70B7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#181B21" BorderBrush="#3A404A">
            <TabItem Header="미리보기 목록">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="목록 표시와 성능"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#70B7FF" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="1" Text="페이지당 항목 수"/>
                        <ComboBox x:Name="PageSizeBox" Grid.Row="1" Grid.Column="1" IsEditable="True">
                            <ComboBoxItem Content="150"/><ComboBoxItem Content="300"/>
                            <ComboBoxItem Content="500"/><ComboBoxItem Content="750"/><ComboBoxItem Content="1000"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="마우스 휠 속도"/>
                        <ComboBox x:Name="WheelSpeedBox" Grid.Row="2" Grid.Column="1">
                            <ComboBoxItem Content="1배"/><ComboBoxItem Content="2배"/><ComboBoxItem Content="3배"/>
                            <ComboBoxItem Content="4배"/><ComboBoxItem Content="5배"/>
                        </ComboBox>
                        <TextBlock Grid.Row="3" Text="기본 정렬"/>
                        <ComboBox x:Name="SortFieldBox" Grid.Row="3" Grid.Column="1">
                            <ComboBoxItem Content="이름"/><ComboBoxItem Content="수정한 날짜"/>
                            <ComboBoxItem Content="만든 날짜"/><ComboBoxItem Content="파일 형식"/><ComboBoxItem Content="크기"/>
                        </ComboBox>
                        <TextBlock Grid.Row="4" Text="정렬 방향"/>
                        <ComboBox x:Name="SortDirectionBox" Grid.Row="4" Grid.Column="1">
                            <ComboBoxItem Content="오름차순"/><ComboBoxItem Content="내림차순"/>
                        </ComboBox>
                        <TextBlock Grid.Row="5" Text="폴더 표시"/>
                        <CheckBox x:Name="FoldersFirstCheckBox" Grid.Row="5" Grid.Column="1"
                                  Content="파일보다 폴더를 먼저 표시" Margin="7,9"/>
                        <TextBlock Grid.Row="6" Text="미리보기 캐시 최대 용량"/>
                        <ComboBox x:Name="CacheSizeBox" Grid.Row="6" Grid.Column="1" IsEditable="True">
                            <ComboBoxItem Content="512"/><ComboBoxItem Content="1024"/><ComboBoxItem Content="2048"/>
                            <ComboBoxItem Content="4096"/><ComboBoxItem Content="8192"/>
                        </ComboBox>
                        <TextBlock Grid.Row="7" Text="현재 캐시"/>
                        <DockPanel Grid.Row="7" Grid.Column="1">
                            <Button x:Name="ClearCacheButton" DockPanel.Dock="Right" Content="캐시 삭제"
                                    Click="ClearCache_Click"/>
                            <TextBlock x:Name="CacheStatusText" Foreground="#9DA7B5" Margin="7,0"
                                       Text="캐시 정보 확인 중…"/>
                        </DockPanel>
                        <TextBlock Grid.Row="8" Grid.ColumnSpan="2"
                                   Text="페이지당 항목 수와 캐시 용량이 클수록 더 많은 미리보기를 유지하지만 메모리와 저장 공간 사용량이 늘어납니다."
                                   Foreground="#9DA7B5" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="접두어">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="접두어 형식 관리" FontSize="18" FontWeight="SemiBold"
                               Foreground="#70B7FF" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1"
                               Text="폴더명 맨 앞에서 인식할 여는 기호와 닫는 기호를 지정합니다. 셀을 두 번 클릭하면 수정할 수 있습니다."
                               Foreground="#B9C0CA" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <DataGrid x:Name="PrefixPatternGrid" Grid.Row="2" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="#181B21" Foreground="#F2F4F7" BorderBrush="#3A404A"
                              RowBackground="#1C2027" AlternatingRowBackground="#222731"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2A2E36"/>
                                <Setter Property="Foreground" Value="#F2F4F7"/>
                                <Setter Property="Padding" Value="9,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="여는 기호" Width="*"
                                                Binding="{Binding Opening, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="닫는 기호" Width="*"
                                                Binding="{Binding Closing, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="표시 예시" Width="1.4*" IsReadOnly="True"
                                                Binding="{Binding Example}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="3" Margin="0,9,0,0">
                        <Button DockPanel.Dock="Right" Content="기본값 복원" Click="ResetPrefixPatterns_Click"/>
                        <Button Content="형식 추가" Click="AddPrefixPattern_Click"/>
                        <Button Content="선택 삭제" Click="DeletePrefixPattern_Click"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="뷰어 및 번역">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="이미지 보기와 번역"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#70B7FF" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="1" Text="Esc 키"/>
                        <CheckBox x:Name="ExitOnEscapeCheckBox" Grid.Row="1" Grid.Column="1"
                                  Content="이미지 화면에서 프로그램 종료" Margin="7,9"/>
                        <TextBlock Grid.Row="2" Text="기본 번역 결과 언어"/>
                        <ComboBox x:Name="TargetLanguageBox" Grid.Row="2" Grid.Column="1" SelectedValuePath="Tag">
                            <ComboBoxItem Content="한국어" Tag="ko"/><ComboBoxItem Content="영어" Tag="en"/>
                            <ComboBoxItem Content="일본어" Tag="ja"/><ComboBoxItem Content="중국어(간체)" Tag="zh-Hans"/>
                            <ComboBoxItem Content="중국어(번체)" Tag="zh-Hant"/><ComboBoxItem Content="프랑스어" Tag="fr"/>
                            <ComboBoxItem Content="독일어" Tag="de"/><ComboBoxItem Content="스페인어" Tag="es"/>
                        </ComboBox>
                        <TextBlock Grid.Row="3" Text="번역 엔진"/>
                        <ComboBox x:Name="TranslationProviderBox" Grid.Row="3" Grid.Column="1" SelectedValuePath="Tag">
                            <ComboBoxItem Content="고품질 로컬 AI · Qwen3-8B (추천)" Tag="BuiltInQwen"/>
                            <ComboBoxItem Content="빠른 무료 온라인 · MyMemory" Tag="MyMemory"/>
                            <ComboBoxItem Content="외부 로컬 서버 · Ollama" Tag="Ollama"/>
                        </ComboBox>
                        <TextBlock Grid.Row="4" Text="Qwen 로컬 모델"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,5">
                            <DockPanel>
                                <Button x:Name="DownloadQwenModelButton" DockPanel.Dock="Left"
                                        Content="모델 다운로드 (약 5GB)" Click="DownloadQwenModel_Click"/>
                                <TextBlock x:Name="QwenModelStatusText" Margin="9,0,0,0" VerticalAlignment="Center"
                                           Foreground="#8FC9FF" TextWrapping="Wrap"/>
                            </DockPanel>
                            <ProgressBar x:Name="QwenDownloadProgress" Height="7" Margin="0,7,0,0"
                                         Minimum="0" Maximum="100" Visibility="Collapsed"/>
                        </StackPanel>
                        <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4">
                            <Button DockPanel.Dock="Right" Content="찾아보기…" Click="BrowseQwenModelFolder_Click"/>
                            <TextBox x:Name="QwenModelFolderBox" Margin="0,0,7,0" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Grid.Row="5" Text="모델 저장 폴더"/>
                        <TextBlock Grid.Row="6" Text="Ollama 서버"/>
                        <TextBox x:Name="OllamaEndpointBox" Grid.Row="6" Grid.Column="1"/>
                        <TextBlock Grid.Row="7" Text="Ollama 모델"/>
                        <TextBox x:Name="OllamaModelBox" Grid.Row="7" Grid.Column="1"/>
                        <TextBlock Grid.Row="8" Text="번역 사전 처리"/>
                        <CheckBox x:Name="TranslationPrefetchCheckBox" Grid.Row="8" Grid.Column="1"
                                  Content="다음 이미지를 백그라운드에서 미리 번역 (CPU·네트워크 사용 증가)"
                                  Margin="7,9"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="태그 데이터">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Text="태그 백업과 관리" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#70B7FF" Margin="0,0,0,12"/>
                        <DockPanel>
                            <CheckBox x:Name="TagAutoBackupCheckBox" Content="하루 한 번 자동 백업"
                                      IsChecked="True" VerticalAlignment="Center" Margin="7,9"/>
                            <TextBlock DockPanel.Dock="Right" Text="개 보관" Margin="3,0,8,0"/>
                            <ComboBox x:Name="TagBackupRetentionBox" DockPanel.Dock="Right" Width="90" IsEditable="True">
                                <ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="20"/>
                                <ComboBoxItem Content="30"/><ComboBoxItem Content="50"/>
                            </ComboBox>
                        </DockPanel>
                        <Separator Margin="0,10" Background="#3A404A"/>
                        <WrapPanel>
                            <Button Content="수동 백업" Click="BackupTags_Click"/>
                            <Button Content="백업 복원" Click="RestoreTags_Click"/>
                            <Button Content="JSON/CSV 내보내기" Click="ExportTags_Click"/>
                            <Button Content="태그 경로 변경" Click="RemapTagPaths_Click"/>
                            <Button Content="태그 리셋" Click="ResetTags_Click"
                                    Background="#6E2730" BorderBrush="#A74A58"/>
                        </WrapPanel>
                        <TextBlock x:Name="TagDataStatusText" Foreground="#9DA7B5" TextWrapping="Wrap"
                                   Text="복원·경로 변경·리셋 전에는 자동으로 안전 백업을 만듭니다." Margin="5,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="업데이트">
                <StackPanel Margin="22">
                    <TextBlock Text="TagSeeker 업데이트" FontSize="18" FontWeight="SemiBold"
                               Foreground="#70B7FF" Margin="0,0,0,12"/>
                    <TextBlock x:Name="CurrentVersionText" Margin="5,4"/>
                    <CheckBox x:Name="AutomaticUpdateCheckBox"
                              Content="프로그램 시작 시 하루 한 번 새 버전 확인"
                              Margin="7,12,7,6"/>
                    <TextBlock Text="새 버전이 있어도 동의 없이 다운로드하거나 설치하지 않습니다. 업데이트할 때 번역 모델, 태그, 설정과 캐시는 유지됩니다."
                               Foreground="#B9C0CA" TextWrapping="Wrap" Margin="5,4,5,12"/>
                    <WrapPanel>
                        <Button x:Name="CheckForUpdateButton" Content="지금 업데이트 확인"
                                Click="CheckForUpdate_Click"/>
                    </WrapPanel>
                    <ProgressBar x:Name="UpdateDownloadProgress" Height="8" Margin="5,12,5,5"
                                 Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock x:Name="UpdateStatusText" Foreground="#9DA7B5"
                               Text="GitHub의 공식 TagSeeker 릴리스를 확인합니다."
                               TextWrapping="Wrap" Margin="5,7,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="오류 기록 및 진단">
                <StackPanel Margin="22">
                    <TextBlock Text="오류 기록과 문제 해결" FontSize="18" FontWeight="SemiBold"
                               Foreground="#70B7FF" Margin="0,0,0,12"/>
                    <TextBlock Text="프로그램 오류는 날짜별 로그 파일에 기록됩니다. 문제를 확인할 때 로그 폴더를 열거나 진단 정보를 복사할 수 있습니다."
                               Foreground="#B9C0CA" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <WrapPanel>
                        <Button Content="로그 폴더 열기" Click="OpenLogFolder_Click"/>
                        <Button Content="진단 정보 복사" Click="CopyDiagnostics_Click"/>
                    </WrapPanel>
                    <TextBlock Text="30일이 지난 로그 파일은 프로그램 시작 시 자동으로 삭제됩니다."
                               Foreground="#9DA7B5" Margin="5,12,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="취소" IsCancel="True"/>
            <Button Content="적용" IsDefault="True" Click="Apply_Click" Background="#285B8F"/>
        </StackPanel>
    </Grid>
</Window>
