<Window x:Class="CustomImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TagSeeker" Height="760" Width="1180"
        MinHeight="520" MinWidth="780"
        Background="#111318"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <sys:Double x:Key="ThumbnailItemWidth">190</sys:Double>
        <sys:Double x:Key="ThumbnailPreviewHeight">170</sys:Double>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#2A2E36"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C2027"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style x:Key="ThumbnailItemStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="{DynamicResource ThumbnailItemWidth}"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="#ECEEF2"/>
            <Setter Property="Background" Value="#1B1E24"/>
            <Setter Property="BorderBrush" Value="#2A2E36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#243A58"/>
                    <Setter Property="BorderBrush" Value="#5DA9FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#8491A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Explorer -->
        <Grid x:Name="ExplorerView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#181B21" BorderBrush="#303540" BorderThickness="0,0,0,1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Left" Content="폴더 열기" Click="OpenFolder_Click"/>
                        <Button DockPanel.Dock="Left" Content="↑ 위로" Click="GoUp_Click"/>
                        <Button DockPanel.Dock="Left" Content="⚙ 설정" Click="Settings_Click"/>
                        <Button DockPanel.Dock="Right" Content="새로 고침" Click="Refresh_Click"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="정렬" Foreground="#B9C0CA" VerticalAlignment="Center" Margin="8,0,3,0"/>
                            <ComboBox x:Name="SortFieldBox" Width="108" SelectedIndex="0"
                                      SelectionChanged="ExplorerSort_Changed">
                                <ComboBoxItem Content="이름"/>
                                <ComboBoxItem Content="수정한 날짜"/>
                                <ComboBoxItem Content="만든 날짜"/>
                                <ComboBoxItem Content="파일 형식"/>
                                <ComboBoxItem Content="크기"/>
                            </ComboBox>
                            <ComboBox x:Name="SortDirectionBox" Width="88" SelectedIndex="0"
                                      SelectionChanged="ExplorerSort_Changed">
                                <ComboBoxItem Content="오름차순"/>
                                <ComboBoxItem Content="내림차순"/>
                            </ComboBox>
                            <CheckBox x:Name="FoldersFirstCheckBox" Content="폴더 우선" IsChecked="True"
                                      Foreground="#D9DEE7" VerticalAlignment="Center" Margin="8,0,4,0"
                                      Checked="ExplorerSort_Changed" Unchecked="ExplorerSort_Changed"/>
                        </StackPanel>
                        <TextBox x:Name="FolderPathBox" Margin="7,3" VerticalContentAlignment="Center"
                                 KeyDown="FolderPathBox_KeyDown"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="3,5,3,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="미리보기 크기" Foreground="#B9C0CA" VerticalAlignment="Center" Margin="3,0"/>
                            <Slider x:Name="ThumbnailSizeSlider" Width="112" Minimum="120" Maximum="320"
                                    Value="190" SmallChange="10" LargeChange="30" TickFrequency="10"
                                    VerticalAlignment="Center" ValueChanged="ThumbnailSizeSlider_ValueChanged"
                                    ToolTip="Ctrl+마우스 휠로도 변경할 수 있습니다."/>
                        </StackPanel>
                        <Button x:Name="ClearTagSearchButton" DockPanel.Dock="Right" Content="검색 해제"
                                Click="ClearTagSearch_Click" Visibility="Collapsed"/>
                        <Button DockPanel.Dock="Right" Content="태그 모아보기" Click="SearchTags_Click"/>
                        <ComboBox x:Name="TagMatchModeBox" DockPanel.Dock="Right" Width="68" Margin="4,3" SelectedIndex="0"
                                  SelectionChanged="TagMatchModeBox_SelectionChanged">
                            <ComboBoxItem Content="AND"/>
                            <ComboBoxItem Content="OR"/>
                        </ComboBox>
                        <TextBlock x:Name="TagSelectionText" DockPanel.Dock="Right" Text="선택 0개"
                                   Foreground="#70B7FF" VerticalAlignment="Center" Margin="12,0,7,0"/>
                    </DockPanel>
                    <DockPanel Grid.Row="2" Margin="3,5,3,0" LastChildFill="False">
                        <TextBlock Text="접두어" Foreground="#F0C969" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="3,0,7,0"/>
                        <ToggleButton x:Name="PrefixFilterToggle" MinWidth="150" Padding="10,5"
                                      Content="접두어: 전체" Click="PrefixFilterToggle_Click"/>
                        <TextBlock x:Name="PrefixSelectionText" Text="" Foreground="#70B7FF"
                                   VerticalAlignment="Center" Margin="8,0"/>
                        <CheckBox x:Name="HidePrefixCheckBox" Content="목록에서 접두어 숨기기"
                                  Foreground="#D9DEE7" VerticalAlignment="Center" Margin="12,0,0,0"
                                  Checked="HidePrefix_Changed" Unchecked="HidePrefix_Changed"/>
                        <Popup x:Name="PrefixFilterPopup" PlacementTarget="{Binding ElementName=PrefixFilterToggle}"
                               Placement="Bottom" StaysOpen="False" Closed="PrefixFilterPopup_Closed">
                            <Border Width="360" MaxHeight="430" Padding="10" Background="#20242B"
                                    BorderBrush="#4A5260" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="전체 해제" Padding="8,4"
                                                Click="ClearPrefixFilter_Click"/>
                                        <TextBox x:Name="PrefixSearchBox" Margin="0,3,7,3"
                                                 ToolTip="접두어 검색" TextChanged="PrefixSearchBox_TextChanged"/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="여러 접두어를 선택하면 OR 조건으로 표시합니다."
                                               Foreground="#9CA5B3" FontSize="11" Margin="2,4,2,7"/>
                                    <ListBox x:Name="PrefixOptionList" Grid.Row="2" BorderThickness="0"
                                             Background="#171A20" Foreground="#F4F4F5"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Foreground="#F4F4F5" Padding="5,3"
                                                          Click="PrefixOption_Click"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Popup>
                    </DockPanel>
                    <Border Grid.Row="3" Margin="3,7,3,0" Padding="7,5" Background="#11141A"
                            BorderBrush="#303744" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,5">
                                <TextBlock DockPanel.Dock="Left" Text="태그 세트" Foreground="#F0C969"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,7,0"/>
                                <Button DockPanel.Dock="Right" Content="삭제" Padding="8,3"
                                        ToolTip="현재 태그 세트 삭제" Click="DeleteTagSet_Click"/>
                                <Button DockPanel.Dock="Right" Content="이름 변경" Padding="8,3"
                                        Click="RenameTagSet_Click"/>
                                <Button DockPanel.Dock="Right" Content="+ 새 세트" Padding="8,3"
                                        Click="AddTagSet_Click"/>
                                <ComboBox x:Name="TagSetBox" Width="230" HorizontalAlignment="Left"
                                          DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectionChanged="TagSetBox_SelectionChanged"/>
                            </DockPanel>
                            <DockPanel Grid.Row="1">
                                <StackPanel DockPanel.Dock="Left" Width="158" Margin="0,2,8,0">
                                    <TextBlock Text="현재 세트 태그 (A-Z)" Foreground="#F0C969" FontWeight="SemiBold"/>
                                    <Button Content="+ 태그 추가" Padding="7,3" Margin="0,5,0,0"
                                            Click="AddTagToLibrary_Click"/>
                                    <Button Content="선택 지우기" Padding="7,3" Margin="0,5,0,0"
                                            Click="ClearSelectedTags_Click"/>
                                </StackPanel>
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="TagCloudPanel"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ListBox x:Name="ThumbnailList" Grid.Row="1" Background="#111318" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ThumbnailItemStyle}"
                     SelectionMode="Extended" MouseDoubleClick="ThumbnailList_MouseDoubleClick"
                     PreviewMouseLeftButtonDown="ThumbnailList_PreviewMouseLeftButtonDown"
                     PreviewMouseRightButtonDown="ThumbnailList_PreviewMouseRightButtonDown"
                     PreviewMouseWheel="ThumbnailList_PreviewMouseWheel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="ThumbnailList_SelectionChanged">
                <ListBox.ContextMenu>
                    <ContextMenu Background="#20242B" Foreground="#F4F4F5" BorderBrush="#3A404A">
                        <MenuItem Header="열기" Click="OpenItemFromContextMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="잘라내기" InputGestureText="Ctrl+X" Click="CutItems_Click"/>
                        <MenuItem Header="복사" InputGestureText="Ctrl+C" Click="CopyItems_Click"/>
                        <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V" Click="PasteItems_Click"/>
                        <MenuItem Header="이름 바꾸기" InputGestureText="F2" Click="RenameItem_Click"/>
                        <MenuItem Header="휴지통으로 이동" InputGestureText="Delete" Click="DeleteItems_Click"/>
                        <MenuItem Header="새 폴더" InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click"/>
                        <Separator/>
                        <MenuItem Header="태그 추가" Click="AddTagFromContextMenu_Click"/>
                        <MenuItem Header="태그 적용" Click="ApplyTagFromContextMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="태그 지우기" Click="RemoveTagFromContextMenu_Click"/>
                        <MenuItem Header="태그 수정하기" Click="RenameTagFromContextMenu_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Height="{DynamicResource ThumbnailPreviewHeight}"
                                    Background="#0C0E12" CornerRadius="3" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="미리보기 불러오는 중…" Foreground="#7E8795"
                                               FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="54"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                                            Background="#D9222630" CornerRadius="4" Padding="5,2">
                                        <TextBlock Text="{Binding BadgeGlyph}" FontSize="22"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="2,7,2,1">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TypeLabel}" Foreground="#8F98A6" FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TagsDisplay}" Foreground="#70B7FF" FontSize="11"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TagsText}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Background="#181B21" Padding="12,7">
                <DockPanel>
                    <TextBlock x:Name="StatusText" Foreground="#B9C0CA"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0">
                        <Button x:Name="PreviousPageButton" Content="◀ 이전 페이지" Padding="9,3"
                                Click="PreviousPage_Click"/>
                        <TextBlock x:Name="PagePositionText" Text="1 / 1" Foreground="#D9DEE7"
                                   VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox x:Name="PageJumpBox" Width="64" Margin="3,0" Padding="7,4"
                                 MaxLength="7" VerticalContentAlignment="Center"
                                 ToolTip="이동할 페이지 번호" KeyDown="PageJumpBox_KeyDown"/>
                        <Button Content="이동" Padding="9,3" Click="PageJump_Click"/>
                        <Button x:Name="NextPageButton" Content="다음 페이지 ▶" Padding="9,3"
                                Click="NextPage_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Foreground="#7E8795"
                               Text="Enter/더블클릭: 열기   F5: 새로 고침"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Viewer -->
        <Grid x:Name="ViewerView" Visibility="Collapsed" Background="#050607">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#D9181B21" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Left" Content="← 목록" Click="BackToExplorer_Click"/>
                        <Button DockPanel.Dock="Left" Content="◀ 이전" Click="Previous_Click"/>
                        <Button DockPanel.Dock="Left" Content="다음 ▶" Click="Next_Click"/>
                        <CheckBox x:Name="ExitOnEscapeCheckBox" DockPanel.Dock="Right" Margin="12,0"
                                  Foreground="#E7E9EC" VerticalAlignment="Center" Content="Esc로 프로그램 종료"/>
                        <ComboBox x:Name="ViewModeBox" DockPanel.Dock="Right" Width="220" Margin="6,3"
                                  SelectionChanged="ViewModeBox_SelectionChanged">
                            <ComboBoxItem Tag="FitIncludingSmall" Content="작은 그림도 꽉차게 보기 (Z)"/>
                            <ComboBoxItem Tag="Original" Content="원본 크기(100%)로 보기 (0)"/>
                            <ComboBoxItem Tag="Fit" Content="맞추기 보기 (9)"/>
                            <ComboBoxItem Tag="Fill" Content="꽉차게 보기/폭맞춤 (8)"/>
                            <ComboBoxItem Tag="DualLeftToRight" Content="스마트 두장 보기(왼쪽→오른쪽) (7)"/>
                            <ComboBoxItem Tag="DualRightToLeft" Content="스마트 두장 보기(오른쪽→왼쪽) (6)"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="3,4,3,0">
                        <Button x:Name="OcrPanelButton" DockPanel.Dock="Left" Content="번역"
                                MinWidth="82" Click="TranslationButton_Click"/>
                        <ComboBox x:Name="TargetLanguageBox" DockPanel.Dock="Left" Width="130" Margin="7,0"
                                  SelectedValuePath="Tag" SelectionChanged="TargetLanguageBox_SelectionChanged">
                            <ComboBoxItem Content="한국어" Tag="ko" IsSelected="True"/>
                            <ComboBoxItem Content="영어" Tag="en"/>
                            <ComboBoxItem Content="일본어" Tag="ja"/>
                            <ComboBoxItem Content="중국어(간체)" Tag="zh-Hans"/>
                            <ComboBoxItem Content="중국어(번체)" Tag="zh-Hant"/>
                            <ComboBoxItem Content="프랑스어" Tag="fr"/>
                            <ComboBoxItem Content="독일어" Tag="de"/>
                            <ComboBoxItem Content="스페인어" Tag="es"/>
                        </ComboBox>
                        <TextBlock x:Name="TranslationStatusText" Text="언어를 선택한 뒤 번역을 누르세요."
                                   Foreground="#8F98A6" VerticalAlignment="Center" Margin="3,0"/>
                    </DockPanel>
                </Grid>
            </Border>

            <Grid x:Name="ViewerImageArea" Grid.Row="1" ClipToBounds="True" SizeChanged="ViewerImageArea_SizeChanged">
                <Border x:Name="ImageStage" Background="#050607"/>

                <ScrollViewer x:Name="OriginalScrollViewer" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="OriginalImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>

                <Viewbox x:Name="FitViewbox" Visibility="Collapsed" Stretch="Uniform" StretchDirection="DownOnly">
                    <Image x:Name="FitImage" Stretch="None"/>
                </Viewbox>

                <Image x:Name="FlexibleImage" Visibility="Collapsed"/>

                <Grid x:Name="DualImageGrid" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="DualLeftImage" Grid.Column="0" Margin="2" Stretch="Uniform"/>
                    <Image x:Name="DualRightImage" Grid.Column="1" Margin="2" Stretch="Uniform"/>
                </Grid>

                <Canvas x:Name="TranslationOverlayCanvas" IsHitTestVisible="False" ClipToBounds="True"
                        Panel.ZIndex="50" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="Transparent"/>
            </Grid>

            <Border Grid.Row="2" Background="#D9181B21" Padding="12,7">
                <DockPanel>
                    <TextBlock x:Name="ViewerFileName" Foreground="#F3F4F6" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ViewerPosition" DockPanel.Dock="Right" Foreground="#AAB1BC"/>
                </DockPanel>
            </Border>

            <Border x:Name="OcrPanel" Grid.Row="1" Width="390" HorizontalAlignment="Right"
                    Background="#F21A1E25" BorderBrush="#4A5361" BorderThickness="1,0,0,0"
                    Padding="12" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,7">
                        <Button DockPanel.Dock="Right" Content="✕" Padding="8,3" Click="CloseOcrPanel_Click"/>
                        <TextBlock x:Name="DetectedOcrLanguageText" DockPanel.Dock="Right" Foreground="#70B7FF"
                                   VerticalAlignment="Center" Margin="7,0"/>
                        <TextBlock Text="인식된 문자" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="OcrSourceTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" IsReadOnly="False"/>
                    <DockPanel Grid.Row="2" Margin="0,8">
                        <Button DockPanel.Dock="Right" Content="전체 복사" Click="CopyOcrText_Click"/>
                        <Button DockPanel.Dock="Right" Content="번역" Click="TranslateText_Click"/>
                        <TextBlock DockPanel.Dock="Left" Text="상단에서 결과 언어 선택" Foreground="#B9C0CA" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="TranslatedTextBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
