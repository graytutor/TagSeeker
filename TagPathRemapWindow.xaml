<Window x:Class="CustomImageViewer.TagPathRemapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="태그 경로 일괄 변경" Width="650" Height="280" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#15181E" Foreground="#F2F4F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="70"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   Text="폴더를 이동하거나 드라이브 문자가 바뀌었을 때 저장된 태그 경로를 한꺼번에 변경합니다."
                   TextWrapping="Wrap" Foreground="#B9C0CA" Margin="0,0,0,14"/>
        <TextBlock Grid.Row="1" Text="기존 루트" VerticalAlignment="Center"/>
        <TextBox x:Name="OldRootBox" Grid.Row="1" Grid.Column="1" Margin="4" Padding="8,6"/>
        <Button Grid.Row="1" Grid.Column="2" Content="찾기" Margin="4" Click="BrowseOld_Click"/>
        <TextBlock Grid.Row="2" Text="새 루트" VerticalAlignment="Center"/>
        <TextBox x:Name="NewRootBox" Grid.Row="2" Grid.Column="1" Margin="4" Padding="8,6"/>
        <Button Grid.Row="2" Grid.Column="2" Content="찾기" Margin="4" Click="BrowseNew_Click"/>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="3"
                   Text="예: D:\Manga → E:\Archive\Manga. 기존 루트는 이미 삭제된 경로여도 직접 입력할 수 있습니다."
                   Foreground="#8F98A6" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" IsCancel="True" Padding="16,7" Margin="4"/>
            <Button Content="변경" IsDefault="True" Padding="16,7" Margin="4"
                    Background="#285B8F" Foreground="White" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
