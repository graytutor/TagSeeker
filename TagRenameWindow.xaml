<Window x:Class="CustomImageViewer.TagRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="태그 수정하기" Width="480" Height="285"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#15181E" Foreground="#F2F4F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#2A2E36"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C2027"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Background" Value="#252A32"/>
            <Setter Property="Foreground" Value="#111318"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="태그 이름 수정" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,13" Foreground="#AEB6C2" TextWrapping="Wrap"
                   Text="이름을 바꾸면 해당 태그가 사용된 모든 파일과 폴더에 반영됩니다. 기존 태그 이름과 같으면 두 태그가 합쳐집니다."/>
        <ComboBox x:Name="ExistingTagBox" Grid.Row="2" SelectionChanged="ExistingTagBox_SelectionChanged"/>
        <TextBox x:Name="NewNameBox" Grid.Row="3" Margin="0,9,0,0" KeyDown="NewNameBox_KeyDown"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" Click="Cancel_Click"/>
            <Button Content="이름 변경" Click="Rename_Click" Background="#245A8D" BorderBrush="#4B9AE8"/>
        </StackPanel>
    </Grid>
</Window>
